{
  "id": "/",
  "name": "MailDesk",
  "short_name": "MailDesk",
  "description": "Shared inbox for 1Dollar Digitizing, Aplus Digitizing and Digitizing Zone.",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f6f8fc",
  "theme_color": "#f6f8fc",
  "icons": [
    { "src": "/app-icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/app-icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/app-icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Unread", "url": "/?unread=1", "icons": [{ "src": "/app-icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Sent", "url": "/?folder=sent", "icons": [{ "src": "/app-icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
